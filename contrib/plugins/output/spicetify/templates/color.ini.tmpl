; Spicetify color scheme generated by tinct
; Theme type: {{ themeType . }}
;
; Apply with (Spotify must be closed first):
;   spicetify config current_theme tinct color_scheme tinct
;   spicetify apply

[base]
text                = {{ get . "foreground" | hexNoHash }}
subtext             = {{ get . "foregroundMuted" | hexNoHash }}
sidebar-text        = {{ get . "foreground" | hexNoHash }}
main                = {{ get . "background" | hexNoHash }}
sidebar             = {{ get . "backgroundMuted" | hexNoHash }}
player              = {{ get . "backgroundMuted" | hexNoHash }}
card                = {{ get . "surface" | hexNoHash }}
shadow              = {{ get . "backgroundMuted" | hexNoHash }}
selected-row        = {{ if has . "surfaceContainerHigh" }}{{ get . "surfaceContainerHigh" | hexNoHash }}{{ else }}{{ get . "surface" | hexNoHash }}{{ end }}
button              = {{ get . "accent1" | hexNoHash }}
button-active       = {{ get . "accent2" | hexNoHash }}
button-disabled     = {{ get . "foregroundMuted" | hexNoHash }}
tab-active          = {{ if has . "surfaceContainer" }}{{ get . "surfaceContainer" | hexNoHash }}{{ else }}{{ get . "surface" | hexNoHash }}{{ end }}
notification        = {{ get . "info" | hexNoHash }}
notification-error  = {{ get . "danger" | hexNoHash }}
misc                = {{ get . "foregroundMuted" | hexNoHash }}
