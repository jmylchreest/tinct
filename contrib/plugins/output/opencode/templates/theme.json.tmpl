{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "background": "{{ get . "background" | hex }}",
    "backgroundMuted": "{{ get . "backgroundMuted" | hex }}",
    "foreground": "{{ get . "foreground" | hex }}",
    "foregroundMuted": "{{ get . "foregroundMuted" | hex }}",
    "surface": "{{ get . "surface" | hex }}",
    "surfaceContainer": "{{ get . "surfaceContainer" | hex }}",
    "surfaceContainerLow": "{{ get . "surfaceContainerLow" | hex }}",
    "surfaceContainerHigh": "{{ get . "surfaceContainerHigh" | hex }}",
    "onSurface": "{{ get . "onSurface" | hex }}",
    "onSurfaceVariant": "{{ get . "onSurfaceVariant" | hex }}",
    "outline": "{{ get . "outline" | hex }}",
    "outlineVariant": "{{ get . "outlineVariant" | hex }}",
    "accent1": "{{ get . "accent1" | hex }}",
    "accent2": "{{ get . "accent2" | hex }}",
    "accent3": "{{ get . "accent3" | hex }}",
    "accent4": "{{ get . "accent4" | hex }}",
    "danger": "{{ get . "danger" | hex }}",
    "warning": "{{ get . "warning" | hex }}",
    "success": "{{ get . "success" | hex }}",
    "info": "{{ get . "info" | hex }}",
    "borderMuted": "{{ get . "borderMuted" | hex }}"
  },
  "theme": {
    "primary": "accent1",
    "secondary": "accent2",
    "accent": "accent3",
    "error": "danger",
    "warning": "warning",
    "success": "success",
    "info": "info",
    "text": "foreground",
    "textMuted": "foregroundMuted",
    "background": "background",
    "backgroundPanel": "surfaceContainerLow",
    "backgroundElement": "surfaceContainer",
    "border": "outline",
    "borderActive": "accent1",
    "borderSubtle": "outlineVariant",
    "diffAdded": "success",
    "diffRemoved": "danger",
    "diffContext": "onSurfaceVariant",
    "diffHunkHeader": "accent2",
    "diffHighlightAdded": "success",
    "diffHighlightRemoved": "danger",
    "diffAddedBg": "{{ withAlpha (get . "success") 0.15 | hexAlpha }}",
    "diffRemovedBg": "{{ withAlpha (get . "danger") 0.15 | hexAlpha }}",
    "diffContextBg": "background",
    "diffLineNumber": "onSurfaceVariant",
    "diffAddedLineNumberBg": "{{ withAlpha (get . "success") 0.1 | hexAlpha }}",
    "diffRemovedLineNumberBg": "{{ withAlpha (get . "danger") 0.1 | hexAlpha }}",
    "markdownText": "foreground",
    "markdownHeading": "accent1",
    "markdownLink": "accent2",
    "markdownLinkText": "accent3",
    "markdownCode": "success",
    "markdownBlockQuote": "onSurfaceVariant",
    "markdownEmph": "accent4",
    "markdownStrong": "accent1",
    "markdownHorizontalRule": "outlineVariant",
    "markdownListItem": "accent1",
    "markdownListEnumeration": "accent2",
    "markdownImage": "accent3",
    "markdownImageText": "accent2",
    "markdownCodeBlock": "foreground",
    "syntaxComment": "foregroundMuted",
    "syntaxKeyword": "accent4",
    "syntaxFunction": "accent1",
    "syntaxVariable": "foreground",
    "syntaxString": "success",
    "syntaxNumber": "accent3",
    "syntaxType": "accent2",
    "syntaxOperator": "onSurface",
    "syntaxPunctuation": "onSurfaceVariant"
  }
}
