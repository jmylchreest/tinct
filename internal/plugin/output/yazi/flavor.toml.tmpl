# Yazi flavor pack generated by Tinct
# https://github.com/jmylchreest/tinct
#
# This file lives in ~/.config/yazi/flavors/<name>.yazi/. Activate it
# from ~/.config/yazi/theme.toml:
#   [flavor]
#   dark = "tinct"
#   # light = "tinct"   # uncomment to also use it as the light flavor
#
# Restart yazi to apply.
#
# Detected theme: {{ themeType . }}

[mgr]
cwd = { fg = "{{ get . "foreground" | hex }}" }

# Find
find_keyword  = { fg = "{{ get . "warning" | hex }}", bold = true, italic = true, underline = true }
find_position = { fg = "{{ get . "warning" | hex }}", bold = true, italic = true }

# Marker
marker_copied   = { fg = "{{ get . "success" | hex }}", bg = "{{ get . "success" | hex }}" }
marker_cut      = { fg = "{{ get . "danger" | hex }}", bg = "{{ get . "danger" | hex }}" }
marker_marked   = { fg = "{{ get . "info" | hex }}", bg = "{{ get . "info" | hex }}" }
marker_selected = { fg = "{{ get . "accent1" | hex }}", bg = "{{ get . "accent1" | hex }}" }

# Count
count_copied   = { fg = "{{ get . "onSuccess" | hex }}", bg = "{{ get . "success" | hex }}" }
count_cut      = { fg = "{{ get . "onDanger" | hex }}", bg = "{{ get . "danger" | hex }}" }
count_selected = { fg = "{{ get . "onAccent1" | hex }}", bg = "{{ get . "accent1" | hex }}" }

# Border
border_symbol = "│"
border_style  = { fg = "{{ get . "outline" | hex }}" }

# Highlighting
hovered         = { fg = "{{ get . "onAccent1" | hex }}", bg = "{{ get . "accent1" | hex }}" }
preview_hovered = { underline = true }

# Tabs
tab_active   = { fg = "{{ get . "onAccent1" | hex }}", bg = "{{ get . "accent1" | hex }}" }
tab_inactive = { fg = "{{ get . "foregroundMuted" | hex }}", bg = "{{ get . "surfaceContainer" | hex }}" }
tab_width    = 1

# File type colours
[mgr.folder_offset]
fg = "{{ get . "accent1" | hex }}"

[mgr.symlink_offset]
fg = "{{ get . "accent2" | hex }}"

# Status bar
[status]
separator_open  = ""
separator_close = ""
separator_style = { fg = "{{ get . "surfaceContainerHigh" | hex }}", bg = "{{ get . "surfaceContainer" | hex }}" }

mode_normal = { fg = "{{ get . "background" | hex }}", bg = "{{ get . "accent1" | hex }}", bold = true }
mode_select = { fg = "{{ get . "background" | hex }}", bg = "{{ get . "warning" | hex }}", bold = true }
mode_unset  = { fg = "{{ get . "background" | hex }}", bg = "{{ get . "danger" | hex }}", bold = true }

progress_label  = { fg = "{{ get . "foreground" | hex }}", bold = true }
progress_normal = { fg = "{{ get . "accent1" | hex }}", bg = "{{ get . "surfaceContainer" | hex }}" }
progress_error  = { fg = "{{ get . "danger" | hex }}", bg = "{{ get . "surfaceContainer" | hex }}" }

permissions_t = { fg = "{{ get . "accent1" | hex }}" }
permissions_r = { fg = "{{ get . "warning" | hex }}" }
permissions_w = { fg = "{{ get . "danger" | hex }}" }
permissions_x = { fg = "{{ get . "success" | hex }}" }
permissions_s = { fg = "{{ get . "foregroundMuted" | hex }}" }

# Selection / yanking colours
[select]
border   = { fg = "{{ get . "accent1" | hex }}" }
active   = { fg = "{{ get . "accent1" | hex }}" }
inactive = {}

# Input dialog
[input]
border   = { fg = "{{ get . "accent1" | hex }}" }
title    = {}
value    = {}
selected = { reversed = true }

# Confirmation prompt
[confirm]
border       = { fg = "{{ get . "accent1" | hex }}" }
title        = { fg = "{{ get . "accent1" | hex }}" }
content      = {}
list         = {}
btn_yes      = { reversed = true }
btn_no       = {}
btn_labels   = []

# Pick / select prompt
[pick]
border    = { fg = "{{ get . "accent1" | hex }}" }
active    = { fg = "{{ get . "accent2" | hex }}", bold = true }
inactive  = {}

# Help and tasks
[which]
mask            = { bg = "{{ get . "surfaceContainerLow" | hex }}" }
cand            = { fg = "{{ get . "accent2" | hex }}" }
rest            = { fg = "{{ get . "foregroundMuted" | hex }}" }
desc            = { fg = "{{ get . "accent1" | hex }}" }
separator       = "  "
separator_style = { fg = "{{ get . "outline" | hex }}" }

[help]
on      = { fg = "{{ get . "accent1" | hex }}" }
exec    = { fg = "{{ get . "accent2" | hex }}" }
desc    = { fg = "{{ get . "foregroundMuted" | hex }}" }
hovered = { bg = "{{ get . "surfaceContainerHigh" | hex }}", bold = true }
footer  = { fg = "{{ get . "background" | hex }}", bg = "{{ get . "foreground" | hex }}" }

[tasks]
border  = { fg = "{{ get . "accent1" | hex }}" }
title   = {}
hovered = { underline = true }

# Notifications
[notify]
title_info  = { fg = "{{ get . "info" | hex }}" }
title_warn  = { fg = "{{ get . "warning" | hex }}" }
title_error = { fg = "{{ get . "danger" | hex }}" }

# File listing colours
[filetype]
rules = [
  { mime = "image/*", fg = "{{ get . "accent2" | hex }}" },
  { mime = "video/*", fg = "{{ get . "accent3" | hex }}" },
  { mime = "audio/*", fg = "{{ get . "accent4" | hex }}" },
  { mime = "application/zip", fg = "{{ get . "warning" | hex }}" },
  { mime = "application/gzip", fg = "{{ get . "warning" | hex }}" },
  { mime = "application/x-tar", fg = "{{ get . "warning" | hex }}" },
  { mime = "application/x-bzip", fg = "{{ get . "warning" | hex }}" },
  { mime = "application/x-bzip2", fg = "{{ get . "warning" | hex }}" },
  { mime = "application/x-7z-compressed", fg = "{{ get . "warning" | hex }}" },
  { mime = "application/x-rar", fg = "{{ get . "warning" | hex }}" },
  { name = "*/", fg = "{{ get . "accent1" | hex }}" },
  { name = "*", fg = "{{ get . "foreground" | hex }}" },
]
