# WezTerm colour scheme generated by Tinct
# https://github.com/jmylchreest/tinct
#
# Drop this into ~/.config/wezterm/colors/ then activate with
#   config.color_scheme = "tinct"
# in your wezterm.lua. WezTerm watches the file and reloads automatically.
#
# Detected theme: {{ themeType . }}

[colors]
foreground   = "{{ get . "foreground" | hex }}"
background   = "{{ get . "background" | hex }}"
cursor_bg    = "{{ get . "accent1" | hex }}"
cursor_fg    = "{{ get . "background" | hex }}"
cursor_border = "{{ get . "accent1" | hex }}"
selection_fg = "{{ get . "background" | hex }}"
selection_bg = "{{ get . "accent1" | hex }}"
scrollbar_thumb = "{{ get . "outline" | hex }}"
split        = "{{ get . "outlineVariant" | hex }}"

# Visual bell (text-based bell flash).
visual_bell  = "{{ get . "warning" | hex }}"

# Compose-cursor (when the IME / dead keys are active).
compose_cursor = "{{ get . "accent2" | hex }}"

# 16-colour ANSI palette (color0..color15 in xterm-speak).
ansi = [
  "{{ ansi . "black" | hex }}",
  "{{ ansi . "red" | hex }}",
  "{{ ansi . "green" | hex }}",
  "{{ ansi . "yellow" | hex }}",
  "{{ ansi . "blue" | hex }}",
  "{{ ansi . "magenta" | hex }}",
  "{{ ansi . "cyan" | hex }}",
  "{{ ansi . "white" | hex }}",
]
brights = [
  "{{ ansi . "brightblack" | hex }}",
  "{{ ansi . "brightred" | hex }}",
  "{{ ansi . "brightgreen" | hex }}",
  "{{ ansi . "brightyellow" | hex }}",
  "{{ ansi . "brightblue" | hex }}",
  "{{ ansi . "brightmagenta" | hex }}",
  "{{ ansi . "brightcyan" | hex }}",
  "{{ ansi . "brightwhite" | hex }}",
]

# Tab bar.
[colors.tab_bar]
background = "{{ get . "surfaceContainerLow" | hex }}"

[colors.tab_bar.active_tab]
bg_color = "{{ get . "accent1" | hex }}"
fg_color = "{{ get . "onAccent1" | hex }}"
intensity = "Bold"

[colors.tab_bar.inactive_tab]
bg_color = "{{ get . "surfaceContainer" | hex }}"
fg_color = "{{ get . "foregroundMuted" | hex }}"

[colors.tab_bar.inactive_tab_hover]
bg_color = "{{ get . "surfaceContainerHigh" | hex }}"
fg_color = "{{ get . "foreground" | hex }}"

[colors.tab_bar.new_tab]
bg_color = "{{ get . "surfaceContainerLow" | hex }}"
fg_color = "{{ get . "foregroundMuted" | hex }}"

[colors.tab_bar.new_tab_hover]
bg_color = "{{ get . "surfaceContainer" | hex }}"
fg_color = "{{ get . "foreground" | hex }}"
