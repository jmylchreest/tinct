/* Tinct color definitions for Walker launcher */
/* This file is automatically generated by Tinct */
/* https://github.com/jmylchreest/tinct */
/* Theme: {{ themeType . }} */

/* Primary background and foreground colors */
@define-color window_bg_color {{ get . "background" | hex }};
@define-color theme_fg_color {{ get . "foreground" | hex }};

/* Accent color for selections and highlights */
@define-color accent_bg_color {{ get . "accent1" | hex }};

/* Error colors */
@define-color error_bg_color {{ get . "danger" | hex }};
@define-color error_fg_color {{ get . "onDanger" | hex }};
