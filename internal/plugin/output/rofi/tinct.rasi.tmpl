/*
 * rofi colour theme generated by Tinct
 * https://github.com/jmylchreest/tinct
 *
 * Activate with `rofi -theme tinct` or add to ~/.config/rofi/config.rasi:
 *   @theme "tinct"
 *
 * Detected theme: {{ themeType . }}
 *
 * The "* {}" block defines named colour variables. Use them in your own
 * rofi theme via @import or extend this file with element styling.
 */

* {
    /* Surfaces */
    background:                {{ get . "background" | hex }};
    background-muted:          {{ get . "backgroundMuted" | hex }};
    foreground:                {{ get . "foreground" | hex }};
    foreground-muted:          {{ get . "foregroundMuted" | hex }};
    surface:                   {{ get . "surface" | hex }};
    on-surface:                {{ get . "onSurface" | hex }};
    surface-variant:           {{ get . "surfaceVariant" | hex }};
    on-surface-variant:        {{ get . "onSurfaceVariant" | hex }};
    surface-container-lowest:  {{ get . "surfaceContainerLowest" | hex }};
    surface-container-low:     {{ get . "surfaceContainerLow" | hex }};
    surface-container:         {{ get . "surfaceContainer" | hex }};
    surface-container-high:    {{ get . "surfaceContainerHigh" | hex }};
    surface-container-highest: {{ get . "surfaceContainerHighest" | hex }};

    /* Outlines */
    outline:                   {{ get . "outline" | hex }};
    outline-variant:           {{ get . "outlineVariant" | hex }};
    border:                    {{ get . "border" | hex }};

    /* Accents */
    accent1:                   {{ get . "accent1" | hex }};
    on-accent1:                {{ get . "onAccent1" | hex }};
    accent2:                   {{ get . "accent2" | hex }};
    on-accent2:                {{ get . "onAccent2" | hex }};
    accent3:                   {{ get . "accent3" | hex }};
    on-accent3:                {{ get . "onAccent3" | hex }};
    accent4:                   {{ get . "accent4" | hex }};
    on-accent4:                {{ get . "onAccent4" | hex }};

    /* Semantic */
    danger:                    {{ get . "danger" | hex }};
    on-danger:                 {{ get . "onDanger" | hex }};
    warning:                   {{ get . "warning" | hex }};
    on-warning:                {{ get . "onWarning" | hex }};
    success:                   {{ get . "success" | hex }};
    on-success:                {{ get . "onSuccess" | hex }};
    info:                      {{ get . "info" | hex }};
    on-info:                   {{ get . "onInfo" | hex }};

    /* Functional aliases used by the default rules below */
    background-color:          @background;
    text-color:                @foreground;
    border-color:              @accent1;

    spacing:                   0;
}

window {
    background-color: @surface;
    border:           2px;
    border-color:     @accent1;
    border-radius:    8px;
    padding:          12px;
    width:            500px;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, message, listview ];
    spacing:          8px;
}

inputbar {
    background-color: @surface-container;
    text-color:       @on-surface;
    border-radius:    6px;
    padding:          8px;
    children:         [ prompt, entry ];
    spacing:          8px;
}

prompt {
    background-color: transparent;
    text-color:       @accent1;
}

entry {
    background-color: transparent;
    text-color:       @on-surface;
    placeholder:      "Search…";
    placeholder-color: @on-surface-variant;
}

listview {
    background-color: transparent;
    border:           0;
    columns:          1;
    lines:            8;
    spacing:          2px;
    scrollbar:        false;
}

element {
    background-color: transparent;
    text-color:       @on-surface;
    border-radius:    4px;
    padding:          6px 8px;
    spacing:          8px;
}

element selected {
    background-color: @accent1;
    text-color:       @on-accent1;
}

element selected.urgent {
    background-color: @danger;
    text-color:       @on-danger;
}

element-icon {
    background-color: transparent;
    size:             1.2em;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

message {
    background-color: @surface-container-low;
    text-color:       @on-surface-variant;
    border-radius:    4px;
    padding:          6px 8px;
}
