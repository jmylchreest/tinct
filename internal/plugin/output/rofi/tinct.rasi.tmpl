/*
 * rofi colour theme generated by Tinct
 * https://github.com/jmylchreest/tinct
 *
 * Activate with `rofi -theme tinct` or add to ~/.config/rofi/config.rasi:
 *   @theme "tinct"
 *
 * This file imports the palette (tinct-colours.rasi) which exposes every
 * tinct role as a named rasi colour, then applies opinionated styling
 * on top. If you'd prefer only the variables, import the palette into
 * your own rasi theme directly via `@import "tinct-colours.rasi"`.
 *
 * Detected theme: {{ themeType . }}
 */

@import "tinct-colours.rasi"

* {
    /* Functional aliases used by the rules below */
    background-color:          @background;
    text-color:                @foreground;
    border-color:              @accent1;

    spacing:                   0;
}

window {
    background-color: @surface;
    border:           2px;
    border-color:     @accent1;
    border-radius:    8px;
    padding:          12px;
    width:            500px;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, message, listview ];
    spacing:          8px;
}

inputbar {
    background-color: @surface-container;
    text-color:       @on-surface;
    border-radius:    6px;
    padding:          8px;
    children:         [ prompt, entry ];
    spacing:          8px;
}

prompt {
    background-color: transparent;
    text-color:       @accent1;
}

entry {
    background-color: transparent;
    text-color:       @on-surface;
    placeholder:      "Search…";
    placeholder-color: @on-surface-variant;
}

listview {
    background-color: transparent;
    border:           0;
    columns:          1;
    lines:            8;
    spacing:          2px;
    scrollbar:        false;
}

element {
    background-color: transparent;
    text-color:       @on-surface;
    border-radius:    4px;
    padding:          6px 8px;
    spacing:          8px;
}

element selected {
    background-color: @accent1;
    text-color:       @on-accent1;
}

element selected.urgent {
    background-color: @danger;
    text-color:       @on-danger;
}

element-icon {
    background-color: transparent;
    size:             1.2em;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

message {
    background-color: @surface-container-low;
    text-color:       @on-surface-variant;
    border-radius:    4px;
    padding:          6px 8px;
}
