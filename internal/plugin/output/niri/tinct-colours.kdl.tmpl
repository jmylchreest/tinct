// niri colour theme generated by Tinct
// https://github.com/jmylchreest/tinct
//
// This file sets niri's themeable colour properties. niri merges included
// files positionally, so include it near the END of your config.kdl (after
// your own `layout` block) for these colours to take precedence:
//
//   include "{{ .ColorFileName }}"
//
// niri watches included files and live-reloads automatically on change.
//
// Detected theme: {{ themeType . }}

layout {
    focus-ring {
        // Active window: accent1 -> accent2 gradient (matches Hyprland's active border).
        active-gradient from="{{ get . "accent1" | hex }}" to="{{ get . "accent2" | hex }}" angle=45
        inactive-color "{{ get . "backgroundMuted" | hex }}"
    }

    border {
        // Only applied when you enable borders (`border { ... }` without `off`).
        active-color "{{ get . "accent1" | hex }}"
        inactive-color "{{ get . "backgroundMuted" | hex }}"
    }

    insert-hint {
        color "{{ get . "accent2" | hex }}"
    }

    tab-indicator {
        active-color "{{ get . "accent1" | hex }}"
        inactive-color "{{ get . "backgroundMuted" | hex }}"
    }

    shadow {
        color "{{ get . "shadow" | hexAlpha }}"
    }
}

overview {
    backdrop-color "{{ get . "scrim" | hex }}"
}
