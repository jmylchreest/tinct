/* Tinct GTK3 Theme - Generated */
/* For use with adw-gtk3 theme */
/* Theme type: {{ themeType . }} */

/* adw-gtk3/libadwaita color variables */

/* Window colors */
@define-color window_bg_color {{ get . "background" | hex }};
@define-color window_fg_color {{ get . "foreground" | hex }};

/* View colors (text fields, lists, etc) */
@define-color view_bg_color {{ get . "surface" | hex }};
@define-color view_fg_color {{ get . "onSurface" | hex }};

/* Accent colors (interactive elements) */
@define-color accent_bg_color {{ get . "accent1" | hex }};
@define-color accent_fg_color {{ get . "onAccent1" | hex }};
@define-color accent_color {{ get . "accent1" | hex }};

/* Headerbar colors */
@define-color headerbar_bg_color {{ get . "surface" | hex }};
@define-color headerbar_fg_color {{ get . "onSurface" | hex }};
@define-color headerbar_backdrop_color {{ get . "surfaceVariant" | hex }};
@define-color headerbar_shade_color {{ get . "border" | hex }};

/* Card/List colors */
@define-color card_bg_color {{ get . "surface" | hex }};
@define-color card_fg_color {{ get . "onSurface" | hex }};
@define-color card_shade_color {{ get . "border" | hex }};

/* Popover/Menu colors */
@define-color popover_bg_color {{ get . "surface" | hex }};
@define-color popover_fg_color {{ get . "onSurface" | hex }};

/* Dialog colors */
@define-color dialog_bg_color {{ get . "surface" | hex }};
@define-color dialog_fg_color {{ get . "onSurface" | hex }};

/* Sidebar colors */
@define-color sidebar_bg_color {{ get . "surfaceVariant" | hex }};
@define-color sidebar_fg_color {{ get . "onSurfaceVariant" | hex }};
@define-color sidebar_backdrop_color {{ get . "surfaceVariant" | hex }};
@define-color sidebar_shade_color {{ get . "border" | hex }};

/* Status colors */
@define-color warning_bg_color {{ get . "warning" | hex }};
@define-color warning_fg_color {{ get . "onWarning" | hex }};
@define-color warning_color {{ get . "warning" | hex }};

@define-color error_bg_color {{ get . "danger" | hex }};
@define-color error_fg_color {{ get . "onDanger" | hex }};
@define-color error_color {{ get . "danger" | hex }};

@define-color success_bg_color {{ get . "success" | hex }};
@define-color success_fg_color {{ get . "onSuccess" | hex }};
@define-color success_color {{ get . "success" | hex }};

/* Destructive action colors */
@define-color destructive_bg_color {{ get . "danger" | hex }};
@define-color destructive_fg_color {{ get . "onDanger" | hex }};
@define-color destructive_color {{ get . "danger" | hex }};
