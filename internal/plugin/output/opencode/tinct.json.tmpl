{
  "$schema": "https://opencode.ai/theme.json",
  "_comment": "Opencode theme generated by Tinct ({{ themeType . }}) — https://github.com/jmylchreest/tinct. Activate with `theme: \"<name>\"` in opencode.json. Tinct generates a single palette per run; the dark/light slots intentionally hold the same hex so the file is self-contained regardless of how opencode auto-detects the terminal background.",
  "theme": {
    "primary":                  { "dark": "{{ get . "accent1" | hex }}", "light": "{{ get . "accent1" | hex }}" },
    "secondary":                { "dark": "{{ get . "accent2" | hex }}", "light": "{{ get . "accent2" | hex }}" },
    "accent":                   { "dark": "{{ get . "accent1" | hex }}", "light": "{{ get . "accent1" | hex }}" },
    "error":                    { "dark": "{{ get . "danger" | hex }}", "light": "{{ get . "danger" | hex }}" },
    "warning":                  { "dark": "{{ get . "warning" | hex }}", "light": "{{ get . "warning" | hex }}" },
    "success":                  { "dark": "{{ get . "success" | hex }}", "light": "{{ get . "success" | hex }}" },
    "info":                     { "dark": "{{ get . "info" | hex }}", "light": "{{ get . "info" | hex }}" },

    "text":                     { "dark": "{{ get . "foreground" | hex }}", "light": "{{ get . "foreground" | hex }}" },
    "textMuted":                { "dark": "{{ get . "foregroundMuted" | hex }}", "light": "{{ get . "foregroundMuted" | hex }}" },

    "background":               { "dark": "{{ get . "background" | hex }}", "light": "{{ get . "background" | hex }}" },
    "backgroundPanel":          { "dark": "{{ get . "surfaceContainerLow" | hex }}", "light": "{{ get . "surfaceContainerLow" | hex }}" },
    "backgroundElement":        { "dark": "{{ get . "surfaceContainer" | hex }}", "light": "{{ get . "surfaceContainer" | hex }}" },

    "border":                   { "dark": "{{ get . "outlineVariant" | hex }}", "light": "{{ get . "outlineVariant" | hex }}" },
    "borderActive":             { "dark": "{{ get . "outline" | hex }}", "light": "{{ get . "outline" | hex }}" },
    "borderSubtle":             { "dark": "{{ get . "outlineVariant" | hex }}", "light": "{{ get . "outlineVariant" | hex }}" },

    "diffAdded":                { "dark": "{{ get . "success" | hex }}", "light": "{{ get . "success" | hex }}" },
    "diffRemoved":              { "dark": "{{ get . "danger" | hex }}", "light": "{{ get . "danger" | hex }}" },
    "diffContext":              { "dark": "{{ get . "foregroundMuted" | hex }}", "light": "{{ get . "foregroundMuted" | hex }}" },
    "diffHunkHeader":           { "dark": "{{ get . "accent3" | hex }}", "light": "{{ get . "accent3" | hex }}" },
    "diffHighlightAdded":       { "dark": "{{ get . "success" | hex }}", "light": "{{ get . "success" | hex }}" },
    "diffHighlightRemoved":     { "dark": "{{ get . "danger" | hex }}", "light": "{{ get . "danger" | hex }}" },
    "diffAddedBg":              { "dark": "{{ get . "surfaceContainer" | hex }}", "light": "{{ get . "surfaceContainer" | hex }}" },
    "diffRemovedBg":            { "dark": "{{ get . "surfaceContainer" | hex }}", "light": "{{ get . "surfaceContainer" | hex }}" },
    "diffContextBg":            { "dark": "{{ get . "surfaceContainerLow" | hex }}", "light": "{{ get . "surfaceContainerLow" | hex }}" },
    "diffLineNumber":           { "dark": "{{ get . "foregroundMuted" | hex }}", "light": "{{ get . "foregroundMuted" | hex }}" },
    "diffAddedLineNumberBg":    { "dark": "{{ get . "surfaceContainer" | hex }}", "light": "{{ get . "surfaceContainer" | hex }}" },
    "diffRemovedLineNumberBg":  { "dark": "{{ get . "surfaceContainer" | hex }}", "light": "{{ get . "surfaceContainer" | hex }}" },

    "markdownText":             { "dark": "{{ get . "foreground" | hex }}", "light": "{{ get . "foreground" | hex }}" },
    "markdownHeading":          { "dark": "{{ get . "accent1" | hex }}", "light": "{{ get . "accent1" | hex }}" },
    "markdownLink":             { "dark": "{{ get . "info" | hex }}", "light": "{{ get . "info" | hex }}" },
    "markdownLinkText":         { "dark": "{{ get . "accent2" | hex }}", "light": "{{ get . "accent2" | hex }}" },
    "markdownCode":             { "dark": "{{ get . "accent3" | hex }}", "light": "{{ get . "accent3" | hex }}" },
    "markdownBlockQuote":       { "dark": "{{ get . "foregroundMuted" | hex }}", "light": "{{ get . "foregroundMuted" | hex }}" },
    "markdownEmph":             { "dark": "{{ get . "accent2" | hex }}", "light": "{{ get . "accent2" | hex }}" },
    "markdownStrong":           { "dark": "{{ get . "accent1" | hex }}", "light": "{{ get . "accent1" | hex }}" },
    "markdownHorizontalRule":   { "dark": "{{ get . "outlineVariant" | hex }}", "light": "{{ get . "outlineVariant" | hex }}" },
    "markdownListItem":         { "dark": "{{ get . "accent1" | hex }}", "light": "{{ get . "accent1" | hex }}" },
    "markdownListEnumeration":  { "dark": "{{ get . "accent2" | hex }}", "light": "{{ get . "accent2" | hex }}" },
    "markdownImage":            { "dark": "{{ get . "accent4" | hex }}", "light": "{{ get . "accent4" | hex }}" },
    "markdownImageText":        { "dark": "{{ get . "accent2" | hex }}", "light": "{{ get . "accent2" | hex }}" },
    "markdownCodeBlock":        { "dark": "{{ get . "foreground" | hex }}", "light": "{{ get . "foreground" | hex }}" },

    "syntaxComment":            { "dark": "{{ get . "foregroundMuted" | hex }}", "light": "{{ get . "foregroundMuted" | hex }}" },
    "syntaxKeyword":            { "dark": "{{ get . "accent1" | hex }}", "light": "{{ get . "accent1" | hex }}" },
    "syntaxFunction":           { "dark": "{{ get . "accent2" | hex }}", "light": "{{ get . "accent2" | hex }}" },
    "syntaxVariable":           { "dark": "{{ get . "foreground" | hex }}", "light": "{{ get . "foreground" | hex }}" },
    "syntaxString":             { "dark": "{{ get . "success" | hex }}", "light": "{{ get . "success" | hex }}" },
    "syntaxNumber":             { "dark": "{{ get . "warning" | hex }}", "light": "{{ get . "warning" | hex }}" },
    "syntaxType":                { "dark": "{{ get . "accent3" | hex }}", "light": "{{ get . "accent3" | hex }}" },
    "syntaxOperator":           { "dark": "{{ get . "foreground" | hex }}", "light": "{{ get . "foreground" | hex }}" },
    "syntaxPunctuation":        { "dark": "{{ get . "foregroundMuted" | hex }}", "light": "{{ get . "foregroundMuted" | hex }}" }
  }
}
