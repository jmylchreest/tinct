# Tinct theme for Ghostty terminal
# This file is automatically generated by Tinct
# https://github.com/jmylchreest/tinct
#
# To use this theme, add the following to your ~/.config/ghostty/config:
#   theme = tinct
#
# Theme: {{ themeType . }}

# Background and foreground colors
background = {{ get . "background" | hex }}
foreground = {{ get . "foreground" | hex }}

# Cursor colors
cursor-color = {{ get . "accent1" | hex }}
cursor-text = {{ get . "background" | hex }}

# Selection colors
selection-background = {{ get . "accent1" | hex }}
selection-foreground = {{ get . "foreground" | hex }}

# 16-color palette (ANSI colors)
# Black
palette = 0={{ ansi . "black" | hex }}
palette = 8={{ ansi . "bright-black" | hex }}

# Red
palette = 1={{ ansi . "red" | hex }}
palette = 9={{ ansi . "bright-red" | hex }}

# Green
palette = 2={{ ansi . "green" | hex }}
palette = 10={{ ansi . "bright-green" | hex }}

# Yellow
palette = 3={{ ansi . "yellow" | hex }}
palette = 11={{ ansi . "bright-yellow" | hex }}

# Blue
palette = 4={{ ansi . "blue" | hex }}
palette = 12={{ ansi . "bright-blue" | hex }}

# Magenta
palette = 5={{ ansi . "magenta" | hex }}
palette = 13={{ ansi . "bright-magenta" | hex }}

# Cyan
palette = 6={{ ansi . "cyan" | hex }}
palette = 14={{ ansi . "bright-cyan" | hex }}

# White
palette = 7={{ ansi . "white" | hex }}
palette = 15={{ ansi . "bright-white" | hex }}
