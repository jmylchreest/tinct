# btop theme generated by Tinct
# https://github.com/jmylchreest/tinct
#
# Copy or symlink this into ~/.config/btop/themes/ then set
#   color_theme = "{{ .ThemeName }}"
# in ~/.config/btop/btop.conf, or pick it from the btop options menu (press 'p').
#
# Detected theme: {{ themeType . }}

# Main background. Empty string keeps the terminal background (best for transparency).
theme[main_bg]="{{ get . "background" | hex }}"

# Main text colour
theme[main_fg]="{{ get . "foreground" | hex }}"

# Title colour for boxes
theme[title]="{{ get . "accent1" | hex }}"

# Highlight colour for keyboard shortcuts
theme[hi_fg]="{{ get . "accent2" | hex }}"

# Selected item background / foreground (e.g. selected process)
theme[selected_bg]="{{ get . "accent1" | hex }}"
theme[selected_fg]="{{ get . "onAccent1" | hex }}"

# Inactive / disabled text
theme[inactive_fg]="{{ get . "foregroundMuted" | hex }}"

# Misc colours: process box mini graphs, status text, etc.
theme[proc_misc]="{{ get . "accent3" | hex }}"

# Box outlines
theme[cpu_box]="{{ get . "outline" | hex }}"
theme[mem_box]="{{ get . "outline" | hex }}"
theme[net_box]="{{ get . "outline" | hex }}"
theme[proc_box]="{{ get . "outline" | hex }}"

# Box top divider line
theme[div_line]="{{ get . "outlineVariant" | hex }}"

# Title colour and text colour for temperature graphs
theme[temp_start]="{{ get . "success" | hex }}"
theme[temp_mid]="{{ get . "warning" | hex }}"
theme[temp_end]="{{ get . "danger" | hex }}"

# CPU usage graph (per-core or aggregate)
theme[cpu_start]="{{ get . "accent1" | hex }}"
theme[cpu_mid]="{{ get . "accent2" | hex }}"
theme[cpu_end]="{{ get . "accent3" | hex }}"

# Memory & swap usage gradients
theme[free_start]="{{ get . "success" | hex }}"
theme[free_mid]=""
theme[free_end]=""
theme[cached_start]="{{ get . "info" | hex }}"
theme[cached_mid]=""
theme[cached_end]=""
theme[available_start]="{{ get . "accent2" | hex }}"
theme[available_mid]=""
theme[available_end]=""
theme[used_start]="{{ get . "accent1" | hex }}"
theme[used_mid]="{{ get . "warning" | hex }}"
theme[used_end]="{{ get . "danger" | hex }}"

# Disk activity gradients
theme[download_start]="{{ get . "info" | hex }}"
theme[download_mid]="{{ get . "accent1" | hex }}"
theme[download_end]="{{ get . "accent2" | hex }}"
theme[upload_start]="{{ get . "warning" | hex }}"
theme[upload_mid]="{{ get . "accent3" | hex }}"
theme[upload_end]="{{ get . "danger" | hex }}"

# Process box graphs
theme[process_start]="{{ get . "accent1" | hex }}"
theme[process_mid]="{{ get . "accent2" | hex }}"
theme[process_end]="{{ get . "accent3" | hex }}"

# Meter colour, gradient or single
theme[meter_bg]="{{ get . "surfaceContainer" | hex }}"
