# Midnight Commander skin generated by Tinct
# https://github.com/jmylchreest/tinct
#
# Install: copy to ~/.local/share/mc/skins/tinct.ini
# Apply:   mc -S tinct
# Or set in ~/.config/mc/ini: skin=tinct
#
# Detected theme: {{ themeType . }}
# Requires 256-color terminal support.

{{- /* Precompute all mc256 colors for reuse */ -}}
{{- $bg := get . "background" | xterm256 }}
{{- $bgMuted := get . "backgroundMuted" | xterm256 }}
{{- $fg := get . "foreground" | xterm256 }}
{{- $fgMuted := get . "foregroundMuted" | xterm256 }}
{{- $accent1 := get . "accent1" | xterm256 }}
{{- $accent2 := get . "accent2" | xterm256 }}
{{- $accent3 := get . "accent3" | xterm256 }}
{{- $accent4 := get . "accent4" | xterm256 }}
{{- $danger := get . "danger" | xterm256 }}
{{- $warning := get . "warning" | xterm256 }}
{{- $success := get . "success" | xterm256 }}
{{- $info := get . "info" | xterm256 }}
{{- $surface := get . "surface" | xterm256 }}
{{- $onSurface := get . "onSurface" | xterm256 }}
{{- $outline := get . "outline" | xterm256 }}
{{- $surfaceContainer := get . "surfaceContainer" | xterm256 }}
{{- $surfaceContainerHigh := get . "surfaceContainerHigh" | xterm256 }}
{{- $surfaceContainerLow := get . "surfaceContainerLow" | xterm256 }}
{{- $onAccent1 := get . "onAccent1" | xterm256 }}

[skin]
    description = Tinct - {{ themeType . }} theme
    256colors = true

[lines]
    horiz = ─
    vert = │
    lefttop = ┌
    righttop = ┐
    leftbottom = └
    rightbottom = ┘
    topmiddle = ┬
    bottommiddle = ┴
    leftmiddle = ├
    rightmiddle = ┤
    cross = ┼
    dhoriz = ═
    dvert = ║
    dlefttop = ╔
    drighttop = ╗
    dleftbottom = ╚
    drightbottom = ╝
    dtopmiddle = ╤
    dbottommiddle = ╧
    dleftmiddle = ╟
    drightmiddle = ╢

# ============================================================================
# Core UI
# ============================================================================

[core]
    _default_ = {{ $fg }};{{ $bg }}
    selected = {{ $onAccent1 }};{{ $accent1 }}
    marked = {{ $accent2 }};;bold
    markselect = {{ $accent2 }};{{ $accent1 }};bold
    gauge = {{ $onAccent1 }};{{ $accent1 }}
    input = {{ $fg }};{{ $surfaceContainerLow }}
    inputunchanged = {{ $fgMuted }};{{ $surfaceContainerLow }}
    inputmark = {{ $onAccent1 }};{{ $accent1 }}
    disabled = {{ $fgMuted }};{{ $bg }}
    reverse = {{ $bg }};{{ $fg }}
    commandlinemark = {{ $onAccent1 }};{{ $accent1 }}
    header = {{ $accent1 }};;bold
    inputhistory = {{ $fg }};{{ $surfaceContainerLow }}
    commandhistory = {{ $fg }};{{ $surfaceContainerLow }}

[core.ad]
    _default_ = {{ $fg }};{{ $bg }}

# ============================================================================
# Dialog Boxes
# ============================================================================

[dialog]
    _default_ = {{ $onSurface }};{{ $surface }}
    dfocus = {{ $onAccent1 }};{{ $accent1 }};bold
    dhotnormal = {{ $accent2 }};{{ $surface }}
    dhotfocus = {{ $accent2 }};{{ $accent1 }};bold
    dtitle = {{ $accent1 }};{{ $surface }};bold

# ============================================================================
# Error Dialogs
# ============================================================================

[error]
    _default_ = {{ $fg }};{{ $danger }}
    errdfocus = {{ $onAccent1 }};{{ $accent1 }};bold
    errdhotnormal = {{ $warning }};{{ $danger }}
    errdhotfocus = {{ $warning }};{{ $accent1 }};bold
    errdtitle = {{ $fg }};{{ $danger }};bold

# ============================================================================
# File Highlight
# ============================================================================
# Unix-convention color mapping for file types

[filehighlight]
    directory = {{ $accent1 }};bold
    executable = {{ $success }}
    symlink = {{ $accent3 }}
    hardlink = {{ $accent3 }}
    stalelink = {{ $danger }}
    device = {{ $accent4 }};bold
    special = {{ $warning }}
    core = {{ $danger }};bold
    temp = {{ $fgMuted }}
    archive = {{ $warning }};bold
    doc = {{ $info }}
    source = {{ $accent2 }}
    media = {{ $accent4 }}
    graph = {{ $accent4 }}
    database = {{ $accent2 }};bold

# ============================================================================
# Menus
# ============================================================================

[menu]
    _default_ = {{ $onSurface }};{{ $surface }}
    menusel = {{ $onAccent1 }};{{ $accent1 }}
    menuhot = {{ $accent2 }};{{ $surface }}
    menuhotsel = {{ $accent2 }};{{ $accent1 }};bold
    menuinactive = {{ $fgMuted }};{{ $surface }}

# ============================================================================
# Popup Menus
# ============================================================================

[popupmenu]
    _default_ = {{ $onSurface }};{{ $surfaceContainerHigh }}
    menusel = {{ $onAccent1 }};{{ $accent1 }}
    menutitle = {{ $accent1 }};{{ $surfaceContainerHigh }};bold

# ============================================================================
# Button Bar (F-key bar at bottom)
# ============================================================================

[buttonbar]
    button = {{ $fg }};{{ $surfaceContainer }}
    hotkey = {{ $accent1 }};{{ $surfaceContainer }};bold

# ============================================================================
# Status Bar
# ============================================================================

[statusbar]
    _default_ = {{ $fg }};{{ $surfaceContainer }}

# ============================================================================
# Help Viewer
# ============================================================================

[help]
    _default_ = {{ $fg }};{{ $bg }}
    helpitalic = {{ $accent3 }}
    helpbold = {{ $accent1 }};bold
    helplink = {{ $info }}
    helpslink = {{ $onAccent1 }};{{ $accent1 }}
    helptitle = {{ $accent1 }};;bold

# ============================================================================
# Internal Editor
# ============================================================================

[editor]
    _default_ = {{ $fg }};{{ $bg }}
    editbold = {{ $accent1 }};;bold
    editmarked = {{ $onAccent1 }};{{ $accent1 }}
    editwhitespace = {{ $fgMuted }};{{ $bgMuted }}
    editnonprintable = {{ $danger }};{{ $bg }}
    editlinestate = {{ $fgMuted }};{{ $surfaceContainerLow }}
    bookmark = {{ $fg }};{{ $surfaceContainerHigh }}
    bookmarkfound = {{ $onAccent1 }};{{ $accent1 }}
    editrightmargin = {{ $outline }};{{ $bg }}
    editbg = {{ $bg }}
    editframe = {{ $outline }};{{ $bg }}
    editframeactive = {{ $accent1 }};{{ $bg }}
    editframedrag = {{ $warning }};{{ $bg }}

# ============================================================================
# Internal Viewer
# ============================================================================

[viewer]
    _default_ = {{ $fg }};{{ $bg }}
    viewbold = ;;bold
    viewunderline = ;;underline
    viewselected = {{ $onAccent1 }};{{ $accent1 }}

# ============================================================================
# Diff Viewer
# ============================================================================

[diffviewer]
    changedline = {{ $fg }};{{ $info }}
    changednew = {{ $fg }};{{ $success }}
    changed = {{ $fg }};{{ $info }}
    added = {{ $fg }};{{ $success }}
    removed = {{ $fg }};{{ $danger }}
    error = {{ $fg }};{{ $danger }}

# ============================================================================
# Widget: Panel
# ============================================================================

[widget-panel]
    sort-up-char = strcat strcat " " strcat " " strcat " " strcat "▴" " "
    sort-down-char = strcat StrCat " " strcat " " strcat " " strcat "▾" " "
    hiddenfiles-show-char = •
    hiddenfiles-hide-char = ○
    history-prev-item-char = «
    history-next-item-char = »
    history-show-list-char = strcat "▾" " "
    filename-scroll-left-char = «
    filename-scroll-right-char = »

# ============================================================================
# Widget: Scrollbar
# ============================================================================

[widget-scrollbar]
    first-vert-char = ▲
    last-vert-char = ▼
    first-horiz-char = ◀
    last-horiz-char = ▶
    current-char = █
    background-char = ▒

# ============================================================================
# Widget: Editor
# ============================================================================

[widget-editor]
    window-state-char = strcat ↕ " "
    window-close-char = ✕
