# Rosec prompt theme - Generated by Tinct
# Theme: {{ themeType . }}
#
# Merge this into your ~/.config/rosec/config.toml under [prompt.theme],
# or include it via your preferred TOML merge strategy.

[prompt.theme]
background       = "{{ get . "background" | hex }}cc"
foreground       = "{{ get . "foreground" | hexAlpha }}"
border_color     = "{{ get . "accent1" | hexAlpha }}"
label_color      = "{{ get . "foregroundMuted" | hexAlpha }}"
accent_color     = "{{ get . "accent1" | hexAlpha }}"
danger_color     = "{{ get . "danger" | hexAlpha }}"
input_background = "{{ get . "surface" | hexAlpha }}"
input_text       = "{{ get . "foreground" | hexAlpha }}"
confirm_background = "{{ get . "success" | hexAlpha }}"
confirm_text     = "{{ get . "foreground" | hexAlpha }}"
cancel_background = "{{ get . "backgroundMuted" | hexAlpha }}"
cancel_text      = "{{ get . "foregroundMuted" | hexAlpha }}"
