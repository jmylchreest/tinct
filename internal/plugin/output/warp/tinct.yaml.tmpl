# Tinct theme for Warp terminal
# This file is automatically generated by Tinct
# https://github.com/jmylchreest/tinct
#
# Warp picks up new themes from this directory automatically (file
# watcher). Select via Settings → Appearance → Theme.

name: Tinct
accent: '{{ get . "accent1" | hex }}'
cursor: '{{ get . "accent1" | hex }}'
background: '{{ get . "background" | hex }}'
foreground: '{{ get . "foreground" | hex }}'
details: {{ if eq (themeType .) "dark" }}lighter{{ else }}darker{{ end }}
terminal_colors:
  normal:
    black: '{{ ansi . "black" | hex }}'
    red: '{{ ansi . "red" | hex }}'
    green: '{{ ansi . "green" | hex }}'
    yellow: '{{ ansi . "yellow" | hex }}'
    blue: '{{ ansi . "blue" | hex }}'
    magenta: '{{ ansi . "magenta" | hex }}'
    cyan: '{{ ansi . "cyan" | hex }}'
    white: '{{ ansi . "white" | hex }}'
  bright:
    black: '{{ ansi . "bright-black" | hex }}'
    red: '{{ ansi . "bright-red" | hex }}'
    green: '{{ ansi . "bright-green" | hex }}'
    yellow: '{{ ansi . "bright-yellow" | hex }}'
    blue: '{{ ansi . "bright-blue" | hex }}'
    magenta: '{{ ansi . "bright-magenta" | hex }}'
    cyan: '{{ ansi . "bright-cyan" | hex }}'
    white: '{{ ansi . "bright-white" | hex }}'
