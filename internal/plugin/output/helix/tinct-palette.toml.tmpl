# Helix palette generated by Tinct
# https://github.com/jmylchreest/tinct
#
# Lives at {{ .OutputDir }}/{{ .ColorFileName }}.
#
# This file is just a [palette] block. The companion tinct.toml binds
# UI / syntax keys to these names via `inherits = "tinct-palette"`.
# Edit the names here if you want to remap; reference them by bare
# name from any other Helix theme that inherits this palette.
#
# Detected theme: {{ themeType . }}

[palette]
background          = "{{ get . "background"          | hex }}"
backgroundMuted     = "{{ get . "backgroundMuted"     | hex }}"
foreground          = "{{ get . "foreground"          | hex }}"
foregroundMuted     = "{{ get . "foregroundMuted"     | hex }}"

accent1             = "{{ get . "accent1"             | hex }}"
accent1Muted        = "{{ get . "accent1Muted"        | hex }}"
accent2             = "{{ get . "accent2"             | hex }}"
accent2Muted        = "{{ get . "accent2Muted"        | hex }}"
accent3             = "{{ get . "accent3"             | hex }}"
accent3Muted        = "{{ get . "accent3Muted"        | hex }}"
accent4             = "{{ get . "accent4"             | hex }}"
accent4Muted        = "{{ get . "accent4Muted"        | hex }}"

onAccent1           = "{{ get . "onAccent1"           | hex }}"
onAccent2           = "{{ get . "onAccent2"           | hex }}"
onAccent3           = "{{ get . "onAccent3"           | hex }}"
onAccent4           = "{{ get . "onAccent4"           | hex }}"

danger              = "{{ get . "danger"              | hex }}"
warning             = "{{ get . "warning"             | hex }}"
success             = "{{ get . "success"             | hex }}"
info                = "{{ get . "info"                | hex }}"
notification        = "{{ get . "notification"        | hex }}"

surface             = "{{ get . "surface"             | hex }}"
surfaceVariant      = "{{ get . "surfaceVariant"      | hex }}"
onSurface           = "{{ get . "onSurface"           | hex }}"
onSurfaceVariant    = "{{ get . "onSurfaceVariant"    | hex }}"
outline             = "{{ get . "outline"             | hex }}"
outlineVariant      = "{{ get . "outlineVariant"      | hex }}"
border              = "{{ get . "border"              | hex }}"
borderMuted         = "{{ get . "borderMuted"         | hex }}"
