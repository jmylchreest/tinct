# Helix theme generated by Tinct
# https://github.com/jmylchreest/tinct
#
# Activate by setting in ~/.config/helix/config.toml:
#   theme = "tinct"
# Or run inside Helix: :config-reload then :theme tinct
#
# This theme inherits its colour names from tinct-palette.toml, which
# tinct rewrites every run. Edit this file freely to add or remap UI
# keys — your edits survive future generations unless you also asked
# tinct to overwrite tinct.toml.
#
# Detected theme: {{ themeType . }}

inherits = "tinct-palette"

# ----------------------------------------------------------------------
# Editor surface
# ----------------------------------------------------------------------

"ui.background"          = { bg = "background" }
"ui.background.separator" = { fg = "outlineVariant" }
"ui.text"                = "foreground"
"ui.text.focus"          = { fg = "foreground", modifiers = ["bold"] }
"ui.text.inactive"       = "foregroundMuted"
"ui.text.info"           = { fg = "info" }

"ui.cursor"              = { fg = "background", bg = "accent1" }
"ui.cursor.primary"      = { fg = "background", bg = "accent1", modifiers = ["bold"] }
"ui.cursor.match"        = { fg = "warning", modifiers = ["bold"] }
"ui.cursor.insert"       = { fg = "background", bg = "foreground" }
"ui.cursor.select"       = { fg = "background", bg = "accent2" }
"ui.cursorline.primary"  = { bg = "surface" }
"ui.cursorline.secondary" = { bg = "surfaceVariant" }
"ui.cursorcolumn.primary" = { bg = "surface" }

"ui.selection"           = { bg = "backgroundMuted" }
"ui.selection.primary"   = { bg = "accent1Muted" }

"ui.linenr"              = "foregroundMuted"
"ui.linenr.selected"     = { fg = "accent1", modifiers = ["bold"] }

"ui.gutter"              = { bg = "background" }
"ui.gutter.selected"     = { bg = "surface" }

"ui.statusline"          = { fg = "foreground", bg = "surface" }
"ui.statusline.inactive" = { fg = "foregroundMuted", bg = "backgroundMuted" }
"ui.statusline.normal"   = { fg = "onAccent1", bg = "accent1" }
"ui.statusline.insert"   = { fg = "onAccent4", bg = "accent4" }
"ui.statusline.select"   = { fg = "onAccent2", bg = "accent2" }

"ui.bufferline"          = { fg = "foregroundMuted", bg = "surface" }
"ui.bufferline.active"   = { fg = "foreground", bg = "background", modifiers = ["bold"] }
"ui.bufferline.background" = { bg = "backgroundMuted" }

"ui.popup"               = { fg = "foreground", bg = "surface" }
"ui.popup.info"          = { fg = "foreground", bg = "surfaceVariant" }
"ui.window"              = { fg = "outline" }
"ui.help"                = { fg = "foreground", bg = "surface" }

"ui.menu"                = { fg = "foreground", bg = "surface" }
"ui.menu.selected"       = { fg = "onAccent1", bg = "accent1", modifiers = ["bold"] }
"ui.menu.scroll"         = { fg = "foregroundMuted", bg = "surfaceVariant" }

"ui.virtual.ruler"             = { bg = "surfaceVariant" }
"ui.virtual.whitespace"        = "foregroundMuted"
"ui.virtual.indent-guide"      = "outlineVariant"
"ui.virtual.inlay-hint"        = { fg = "foregroundMuted", modifiers = ["italic"] }
"ui.virtual.wrap"              = "foregroundMuted"
"ui.virtual.jump-label"        = { fg = "warning", modifiers = ["bold"] }

# ----------------------------------------------------------------------
# Diagnostics
# ----------------------------------------------------------------------

"diagnostic.error"   = { underline = { color = "danger", style = "curl" } }
"diagnostic.warning" = { underline = { color = "warning", style = "curl" } }
"diagnostic.info"    = { underline = { color = "info", style = "curl" } }
"diagnostic.hint"    = { underline = { color = "success", style = "curl" } }
"diagnostic.unnecessary" = { modifiers = ["dim"] }
"diagnostic.deprecated"  = { modifiers = ["crossed_out"] }

"error"   = "danger"
"warning" = "warning"
"info"    = "info"
"hint"    = "success"

# ----------------------------------------------------------------------
# Diff gutter
# ----------------------------------------------------------------------

"diff.plus"   = "success"
"diff.minus"  = "danger"
"diff.delta"  = "warning"

# ----------------------------------------------------------------------
# Syntax — generic
# ----------------------------------------------------------------------

"attribute"          = "accent3"
"type"               = "accent1"
"type.builtin"       = { fg = "accent1", modifiers = ["italic"] }
"type.enum.variant"  = "accent4"

"constructor"        = "accent3"

"constant"           = "accent4"
"constant.builtin"   = { fg = "accent4", modifiers = ["italic"] }
"constant.numeric"   = "accent4"
"constant.character" = "success"
"constant.character.escape" = "accent3"

"string"             = "success"
"string.regexp"      = "warning"
"string.special"     = "accent3"

"comment"            = { fg = "foregroundMuted", modifiers = ["italic"] }
"comment.block.documentation" = { fg = "foregroundMuted", modifiers = ["italic"] }

"variable"           = "foreground"
"variable.builtin"   = { fg = "accent2", modifiers = ["italic"] }
"variable.parameter" = "foreground"
"variable.other.member" = "accent3"

"label"              = "accent2"

"punctuation"        = "foregroundMuted"
"punctuation.delimiter" = "foregroundMuted"
"punctuation.bracket"   = "foreground"
"punctuation.special"   = "accent3"

"keyword"                  = "accent2"
"keyword.control"          = "accent2"
"keyword.control.conditional" = { fg = "accent2", modifiers = ["italic"] }
"keyword.control.repeat"   = { fg = "accent2", modifiers = ["italic"] }
"keyword.control.import"   = "accent3"
"keyword.control.return"   = "danger"
"keyword.control.exception" = "danger"
"keyword.operator"         = "accent2"
"keyword.directive"        = "accent3"
"keyword.function"         = "accent2"
"keyword.storage"          = "accent2"

"operator"           = "foregroundMuted"

"function"           = "accent3"
"function.builtin"   = { fg = "accent3", modifiers = ["italic"] }
"function.method"    = "accent3"
"function.macro"     = "accent4"
"function.special"   = "accent4"

"tag"                = "accent2"
"namespace"          = "accent1"

"special"            = "warning"

# ----------------------------------------------------------------------
# Markup (markdown, rst, …)
# ----------------------------------------------------------------------

"markup.heading"           = { fg = "accent1", modifiers = ["bold"] }
"markup.heading.1"         = { fg = "accent1", modifiers = ["bold"] }
"markup.heading.2"         = { fg = "accent2", modifiers = ["bold"] }
"markup.heading.3"         = { fg = "accent3", modifiers = ["bold"] }
"markup.heading.4"         = { fg = "accent4", modifiers = ["bold"] }
"markup.heading.5"         = "accent4"
"markup.heading.6"         = "accent4"
"markup.heading.marker"    = "foregroundMuted"
"markup.list"              = "accent2"
"markup.list.unnumbered"   = "accent2"
"markup.list.numbered"     = "accent2"
"markup.bold"              = { modifiers = ["bold"] }
"markup.italic"            = { modifiers = ["italic"] }
"markup.strikethrough"     = { modifiers = ["crossed_out"] }
"markup.link.url"          = { fg = "info", modifiers = ["underlined"] }
"markup.link.text"         = "accent3"
"markup.link.label"        = "accent2"
"markup.quote"             = { fg = "foregroundMuted", modifiers = ["italic"] }
"markup.raw"               = "success"
"markup.raw.inline"        = "success"
"markup.raw.block"         = "success"
