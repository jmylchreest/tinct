# tmux palette generated by Tinct
# https://github.com/jmylchreest/tinct
#
# Pure palette: every tinct role exposed as a tmux user option you can
# reference from your own status line or style strings via #{@tinct-<role>}.
#
# Source this from your tmux.conf (directly, or via tinct.conf which also
# applies opinionated styling):
#   source-file ~/.config/tmux/tinct-palette.conf
#
# Detected theme: {{ themeType . }}

set -gq @tinct-background                "{{ get . "background" | hex }}"
set -gq @tinct-background-muted          "{{ get . "backgroundMuted" | hex }}"
set -gq @tinct-foreground                "{{ get . "foreground" | hex }}"
