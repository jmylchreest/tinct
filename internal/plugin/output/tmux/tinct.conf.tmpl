# tmux colour theme generated by Tinct
# https://github.com/jmylchreest/tinct
#
# Source this from your tmux.conf:
#   source-file ~/.config/tmux/tinct.conf
# then reload with prefix-r or `tmux source-file ~/.config/tmux/tmux.conf`.
#
# This file sources the palette (tinct-palette.conf) which exposes every
# tinct role as a tmux user option (@tinct-<role>), then applies an
# opinionated default styling on top. If you only want the variables and
# prefer to write your own status line, source the palette directly:
#   source-file ~/.config/tmux/tinct-palette.conf
#
# Detected theme: {{ themeType . }}

# ----------------------------------------------------------------------------
# Palette: defines @tinct-* user options for every role.
# ----------------------------------------------------------------------------
source-file ~/.config/tmux/tinct-palette.conf

# ----------------------------------------------------------------------------
# Status bar.
# ----------------------------------------------------------------------------
set -g status-style "bg=#{@tinct-surface},fg=#{@tinct-foreground}"
set -g status-left-style "bg=#{@tinct-accent1},fg=#{@tinct-on-accent1},bold"
set -g status-right-style "bg=#{@tinct-surface-container-high},fg=#{@tinct-foreground}"

# ----------------------------------------------------------------------------
# Windows (tab) colours.
# ----------------------------------------------------------------------------
set -g window-status-style "bg=#{@tinct-surface},fg=#{@tinct-foreground-muted}"
set -g window-status-current-style "bg=#{@tinct-accent1},fg=#{@tinct-on-accent1},bold"
set -g window-status-activity-style "bg=#{@tinct-surface},fg=#{@tinct-warning}"
set -g window-status-bell-style "bg=#{@tinct-surface},fg=#{@tinct-danger},bold"

# ----------------------------------------------------------------------------
# Panes.
# ----------------------------------------------------------------------------
set -g pane-border-style "fg=#{@tinct-outline}"
set -g pane-active-border-style "fg=#{@tinct-accent1}"

# ----------------------------------------------------------------------------
# Messages and modes.
# ----------------------------------------------------------------------------
set -g message-style "bg=#{@tinct-accent2},fg=#{@tinct-on-accent2}"
set -g message-command-style "bg=#{@tinct-accent3},fg=#{@tinct-on-accent3}"
set -g mode-style "bg=#{@tinct-accent1},fg=#{@tinct-on-accent1}"

# ----------------------------------------------------------------------------
# Clock and copy mode.
# ----------------------------------------------------------------------------
set -g clock-mode-colour "#{@tinct-accent2}"
set -g copy-mode-match-style "bg=#{@tinct-warning},fg=#{@tinct-on-warning}"
set -g copy-mode-current-match-style "bg=#{@tinct-accent1},fg=#{@tinct-on-accent1}"
