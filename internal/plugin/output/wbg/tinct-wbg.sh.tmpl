#!/bin/sh
# wbg wallpaper configuration generated by Tinct
# https://github.com/jmylchreest/tinct
#
# wbg is a super simple wallpaper application for Wayland compositors
# implementing the layer-shell protocol.
# https://codeberg.org/dnkl/wbg
#
# IMPORTANT: wbg does not persist wallpaper. It is a foreground process
# that displays a single image until killed.
# Source this script from your compositor autostart to set wallpaper on login.
#
# Integration:
#   Hyprland: exec-once = ~/.config/wbg/tinct-wbg.sh
#   Sway:     exec ~/.config/wbg/tinct-wbg.sh
#   Generic:  ~/.config/wbg/tinct-wbg.sh &
#
{{- if .WallpaperPath }}

# ============================================================================
# Wallpaper
# ============================================================================
TINCT_WBG_WALLPAPER="{{ .WallpaperPath }}"

# ============================================================================
# Apply Wallpaper
# ============================================================================
# Kill any existing wbg instance
killall wbg 2>/dev/null

# Start wbg (replaces this shell process)
exec wbg "$TINCT_WBG_WALLPAPER"

{{- else }}

# No wallpaper source provided by input plugin.
# To use this script, regenerate with an image input:
#
#   tinct generate -i image -p /path/to/wallpaper.jpg -o wbg
#
# Or edit this script manually and set TINCT_WBG_WALLPAPER:
# TINCT_WBG_WALLPAPER="/path/to/wallpaper.jpg"
# killall wbg 2>/dev/null
# exec wbg "$TINCT_WBG_WALLPAPER"

{{- end }}

# ============================================================================
# Notes
# ============================================================================
# - wbg displays the image scaled-to-fit on all monitors
# - Use -s/--stretch to stretch-to-fill instead
# - Supported formats: PNG, JPEG, JPEG XL, WebP, SVG
# - To change wallpaper, kill wbg and restart with a new image
