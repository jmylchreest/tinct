# foot colour palette generated by Tinct
# https://github.com/jmylchreest/tinct
#
# Include this fragment from your foot.ini with:
#   include={{ .OutputDir }}/{{ .ColorFileName }}
#
# foot reloads its colour configuration in-place on SIGUSR1, which tinct
# broadcasts automatically after writing the file.
#
# Detected theme: {{ themeType . }}

[colors]
foreground={{ get . "foreground" | hexNoHash }}
background={{ get . "background" | hexNoHash }}

selection-foreground={{ get . "background" | hexNoHash }}
selection-background={{ get . "accent1" | hexNoHash }}

urls={{ get . "accent1" | hexNoHash }}

regular0={{ get . "background" | hexNoHash }}
regular1={{ get . "danger" | hexNoHash }}
regular2={{ get . "success" | hexNoHash }}
regular3={{ get . "warning" | hexNoHash }}
regular4={{ get . "accent1" | hexNoHash }}
regular5={{ get . "accent2" | hexNoHash }}
regular6={{ get . "accent3" | hexNoHash }}
regular7={{ get . "foreground" | hexNoHash }}

bright0={{ get . "backgroundMuted" | hexNoHash }}
bright1={{ get . "danger" | hexNoHash }}
bright2={{ get . "success" | hexNoHash }}
bright3={{ get . "warning" | hexNoHash }}
bright4={{ get . "accent1" | hexNoHash }}
bright5={{ get . "accent2" | hexNoHash }}
bright6={{ get . "accent3" | hexNoHash }}
bright7={{ get . "foregroundMuted" | hexNoHash }}
