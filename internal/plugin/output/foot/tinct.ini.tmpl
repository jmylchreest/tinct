# Example foot configuration generated by Tinct
# https://github.com/jmylchreest/tinct
#
# This file is a starter foot.ini. If you don't already have one, rename
# this to foot.ini:
#
#   mv {{ .OutputDir }}/tinct.ini {{ .OutputDir }}/foot.ini
#
# If you do already have a foot.ini, leave this file alone and just add
# the include= line below to the top of your existing foot.ini.

include={{ .OutputDir }}/{{ .ColorFileName }}

# Font — adjust to taste. foot supports the standard fontconfig syntax.
font=monospace:size=11

# Comfortable defaults; trim or expand as you prefer.
dpi-aware=yes
pad=8x8
initial-window-size-chars=100x30

[scrollback]
lines=10000
multiplier=3.0

[cursor]
style=block
blink=no

[mouse]
hide-when-typing=yes

[key-bindings]
# foot's defaults are sensible; left here as a reminder of where to
# add custom keybinds.

[search-bindings]
# Same — search keybinds go here.
