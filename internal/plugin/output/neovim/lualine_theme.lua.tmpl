-- Tinct lualine theme: {{ .ThemeName }}
-- Generated by tinct - do not edit manually
-- https://github.com/jmylchreest/tinct

{{- $bg := get . "background" }}
{{- $fg := get . "foreground" }}
{{- $bgMuted := get . "backgroundMuted" }}
{{- $fgMuted := get . "foregroundMuted" }}
{{- $accent1 := get . "accent1" }}
{{- $accent2 := get . "accent2" }}
{{- $danger := get . "danger" }}
{{- $warning := get . "warning" }}
{{- $success := get . "success" }}
{{- $info := get . "info" }}

local colors = {
  bg = '{{ $bg | hex }}',
  fg = '{{ $fg | hex }}',
  bg_muted = '{{ $bgMuted | hex }}',
  fg_muted = '{{ $fgMuted | hex }}',
  accent1 = '{{ $accent1 | hex }}',
  accent2 = '{{ $accent2 | hex }}',
  danger = '{{ $danger | hex }}',
  warning = '{{ $warning | hex }}',
  success = '{{ $success | hex }}',
  info = '{{ $info | hex }}',
}

return {
  normal = {
    a = { fg = colors.bg, bg = colors.accent1, gui = 'bold' },
    b = { fg = colors.fg, bg = colors.bg_muted },
    c = { fg = colors.fg_muted, bg = colors.bg },
  },
  insert = {
    a = { fg = colors.bg, bg = colors.success, gui = 'bold' },
    b = { fg = colors.fg, bg = colors.bg_muted },
  },
  visual = {
    a = { fg = colors.bg, bg = colors.accent2, gui = 'bold' },
    b = { fg = colors.fg, bg = colors.bg_muted },
  },
  replace = {
    a = { fg = colors.bg, bg = colors.danger, gui = 'bold' },
    b = { fg = colors.fg, bg = colors.bg_muted },
  },
  command = {
    a = { fg = colors.bg, bg = colors.warning, gui = 'bold' },
    b = { fg = colors.fg, bg = colors.bg_muted },
  },
  terminal = {
    a = { fg = colors.bg, bg = colors.info, gui = 'bold' },
    b = { fg = colors.fg, bg = colors.bg_muted },
  },
  inactive = {
    a = { fg = colors.fg_muted, bg = colors.bg_muted },
    b = { fg = colors.fg_muted, bg = colors.bg_muted },
    c = { fg = colors.fg_muted, bg = colors.bg },
  },
}
