#!/bin/sh
# awww wallpaper configuration generated by Tinct
# https://github.com/jmylchreest/tinct
#
# awww (An Answer to your Wayland Wallpaper Woes)
# https://codeberg.org/LGFae/awww
#
# IMPORTANT: awww does not persist wallpaper across daemon restarts.
# Source this script from your compositor autostart to restore the wallpaper
# after login or daemon restart.
#
# Integration:
#   Hyprland: exec-once = ~/.config/awww/tinct-awww.sh
#   Sway:     exec ~/.config/awww/tinct-awww.sh
#   Generic:  ~/.config/awww/tinct-awww.sh &
#
{{- if .WallpaperPath }}

# ============================================================================
# Wallpaper
# ============================================================================
TINCT_AWWW_WALLPAPER="{{ .WallpaperPath }}"

# ============================================================================
# Transition Settings
# ============================================================================
TINCT_AWWW_TRANSITION_TYPE="{{ .TransitionType }}"
TINCT_AWWW_TRANSITION_STEP="{{ .TransitionStep }}"
TINCT_AWWW_TRANSITION_FPS="{{ .TransitionFPS }}"
{{- if .ResizeMode }}
TINCT_AWWW_RESIZE="{{ .ResizeMode }}"
{{- end }}
{{- if .FillColor }}
TINCT_AWWW_FILL_COLOR="{{ .FillColor }}"
{{- end }}

# ============================================================================
# Apply Wallpaper
# ============================================================================
# Wait for awww-daemon to be ready (it may still be starting)
TINCT_AWWW_RETRIES=0
while ! awww query > /dev/null 2>&1; do
    TINCT_AWWW_RETRIES=$((TINCT_AWWW_RETRIES + 1))
    if [ "$TINCT_AWWW_RETRIES" -ge 10 ]; then
        echo "tinct-awww: awww-daemon not responding after 10 attempts, giving up" >&2
        exit 1
    fi
    sleep 0.5
done

awww img \
    --transition-type "$TINCT_AWWW_TRANSITION_TYPE" \
    --transition-step "$TINCT_AWWW_TRANSITION_STEP" \
    --transition-fps "$TINCT_AWWW_TRANSITION_FPS" \
{{- if .ResizeMode }}
    --resize "$TINCT_AWWW_RESIZE" \
{{- end }}
{{- if .FillColor }}
    --fill-color "$TINCT_AWWW_FILL_COLOR" \
{{- end }}
    "$TINCT_AWWW_WALLPAPER"

{{- else }}

# No wallpaper source provided by input plugin.
# To use this script, regenerate with an image input:
#
#   tinct generate -i image -p /path/to/wallpaper.jpg -o awww
#
# Or edit this script manually:
#   awww img /path/to/wallpaper.jpg

# Clear screen with theme background colour:
awww clear {{ hexNoHash (get . "background") }}

{{- end }}

# ============================================================================
# Colour-Matched Clear Screen
# ============================================================================
# To clear the screen with the theme's background colour instead:
#   awww clear {{ hexNoHash (get . "background") }}

# ============================================================================
# Transition Types Reference
# ============================================================================
# simple  - Fade into the new image (default)
# left    - Slide from the left
# right   - Slide from the right
# top     - Slide from the top
# bottom  - Slide from the bottom
# wipe    - Wipe transition (supports --transition-angle)
# grow    - Grow from a point (supports --transition-pos)
# center  - Expand from center to edges
# outer   - Contract from edges to center
# any     - Random point with center or outer
# random  - Random transition effect
