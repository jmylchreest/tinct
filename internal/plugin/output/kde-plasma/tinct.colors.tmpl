{{- /* KDE Plasma Color Scheme Template for Tinct */ -}}
{{- /* Color format: R,G,B (decimal 0-255) */ -}}
{{- $bg := get . "background" -}}
{{- $fg := get . "foreground" -}}
{{- $accent1 := get . "accent1" -}}
{{- /* Surface roles - prefer surface over background for UI elements */ -}}
{{- $surface := $bg -}}
{{- if has . "surface" }}{{ $surface = get . "surface" }}{{ end -}}
{{- $surfaceVariant := $surface -}}
{{- if has . "surfaceVariant" }}{{ $surfaceVariant = get . "surfaceVariant" }}{{ end -}}
{{- /* Additional accents for visited links and hover states */ -}}
{{- $accent2 := $accent1 -}}
{{- if has . "accent2" }}{{ $accent2 = get . "accent2" }}{{ end -}}
{{- /* Border/outline roles - prefer outline, then border, then muted foreground */ -}}
{{- $border := $fg -}}
{{- if has . "outline" }}{{ $border = get . "outline" }}{{ else if has . "border" }}{{ $border = get . "border" }}{{ else if has . "foregroundMuted" }}{{ $border = get . "foregroundMuted" }}{{ end -}}
{{- /* On-surface color for better text on accent backgrounds */ -}}
{{- $onAccent := $bg -}}
{{- if has . "onAccent1" }}{{ $onAccent = get . "onAccent1" }}{{ end -}}
{{- /* Semantic colors with sensible ANSI fallbacks */ -}}
{{- $danger := ansi . "red" -}}
{{- if has . "danger" }}{{ $danger = get . "danger" }}{{ end -}}
{{- $warning := ansi . "yellow" -}}
{{- if has . "warning" }}{{ $warning = get . "warning" }}{{ end -}}
{{- $success := ansi . "green" -}}
{{- if has . "success" }}{{ $success = get . "success" }}{{ end -}}
[ColorEffects:Disabled]
Color={{ $surface | rgb }}
ColorAmount=0.5
ColorEffect=3
ContrastAmount=0
ContrastEffect=0
IntensityAmount=0
IntensityEffect=0

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={{ $surface | rgb }}
ColorAmount=0.025
ColorEffect=0
ContrastAmount=0.1
ContrastEffect=0
Enable={{ if eq (themeType .) "dark" }}true{{ else }}false{{ end }}
IntensityAmount=0
IntensityEffect=0

