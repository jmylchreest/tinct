/* SwayNC GTK4 colours generated by tinct. Detected theme: {{ themeType . }}
 * Import after other colour rules in style.css. Layout remains user-controlled.
 */
:root {
    --cc-bg: {{ get . "background" | rgba }};
    --noti-border-color: {{ get . "border" | rgba }};
    --noti-bg: {{ (get . "surface").RGBDecimal }};
    --noti-bg-alpha: 1;
    --noti-bg-darker: {{ get . "backgroundMuted" | rgba }};
    --noti-bg-hover: {{ get . "surfaceVariant" | rgba }};
    --noti-bg-focus: {{ get . "surfaceVariant" | rgba }};
    --noti-close-bg: {{ get . "surfaceVariant" | rgba }};
    --noti-close-bg-hover: {{ if has . "accent1Muted" }}{{ get . "accent1Muted" | rgba }}{{ else }}{{ get . "surfaceVariant" | rgba }}{{ end }};
    --text-color: {{ get . "foreground" | rgba }};
    --text-color-disabled: {{ get . "foregroundMuted" | rgba }};
    --bg-selected: {{ get . "accent1" | rgba }};
}
/* Override the default notification border shorthand at higher specificity. */
.notification-row .notification-background .notification.critical {
    border-color: {{ get . "danger" | rgba }};
}
